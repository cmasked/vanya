# Local development only; use managed credentials and HTTPS when deploying.
DATABASE_URL=postgresql://yogya:yogya@localhost:5432/yogya
ALLOWED_ORIGINS=http://localhost:8081
# Server-only speech adapter: raw audio POST with X-Speech-Language;
# returns {text, language}. This is not a direct BHASHINI endpoint.
SPEECH_ADAPTER_URL=
SPEECH_ADAPTER_KEY=
SPEECH_LANGUAGES=en-IN,ta-IN
